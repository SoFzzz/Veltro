# ENVIRONMENT CONFIGURATION - COPY TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT THE .env FILE TO GIT - USE .env.example AS TEMPLATE ONLY

# ============ Database Configuration ============
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=veltro
DB_USERNAME=postgres
DB_PASSWORD=your-db-password-here

# ============ JWT Security ============
# Generate a strong 256-bit secret (min 32 characters)
# Example: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-min-32-characters-required-here

# ============ AI Vision API (Gemini) ============
GEMINI_API_KEY=your-gemini-api-key-here

# ============ Application Profile ============
SPRING_PROFILES_ACTIVE=dev-with-ai

# ============ Server Configuration ============
SERVER_PORT=8080