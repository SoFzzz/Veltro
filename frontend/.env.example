# Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Backend API URL
# Local development: leave empty (Vite proxy handles /api/v1 -> localhost:8080)
# Production (Vercel): set to your Heroku backend URL
# Example: https://veltro-api.herokuapp.com/api/v1
VITE_API_BASE_URL=
