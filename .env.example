# ENVIRONMENT CONFIGURATION TEMPLATE
# Use this file as a reference. Do not store real secrets in version control.

# Database
DB_NAME=veltro
DB_USER=postgres
DB_PASSWORD=postgres

# Security
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# AI API
GEMINI_API_KEY=replace-with-your-gemini-api-key

# CORS (single line, comma-separated, no line breaks)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173
